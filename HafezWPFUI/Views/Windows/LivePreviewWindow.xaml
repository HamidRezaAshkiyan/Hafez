<Window x:Class="HafezWPFUI.Views.Windows.LivePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پیش‌نمایش زنده خروجی و ابزارهای مسجد"
        Height="520"
        Width="760"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1E1E1E" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <TextBlock x:Name="PrayerBannerText"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Text="در حال محاسبه اوقات شرعی..." />
        </Border>

        <Border Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="2" CornerRadius="8" Background="Black">
            <Rectangle x:Name="LivePreviewSurface" Stretch="Uniform" />
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Center">
            <Button Content="حالت شب / روز" Margin="6" Padding="14,6" Click="ToggleTheme_OnClick" />
            <Button Content="انتقال خروجی به مانیتور دوم" Margin="6" Padding="14,6" Click="SnapSecondary_OnClick" />
            <Button Content="اتصال موبایل (QR)" Margin="6" Padding="14,6" Click="OpenQrPairing_OnClick" />
        </WrapPanel>
    </Grid>
</Window>
