<Window x:Class="HafezWPFUI.Views.Windows.QrPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اتصال موبایل (QR Code)"
        Height="460"
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="اسکن با اپلیکیشن کنترل حافظ"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Image x:Name="QrImage" Width="230" Height="230" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,14" HorizontalAlignment="Center">
            <TextBlock x:Name="EndpointText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="ClientsText" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <Button Grid.Row="3"
                Content="بستن"
                Width="120"
                Height="34"
                Click="CloseButton_OnClick" />
    </Grid>
</Window>
